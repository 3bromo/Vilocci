{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/data/:path*", "destination": "/404", "statusCode": 404 },
    { "source": "/dist/:path*", "destination": "/404", "statusCode": 404 }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/img/asset.svg", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/login", "destination": "/admin.html" }
  ]
}

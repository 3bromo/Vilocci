# Spinto Admin — Supabase Configuration
# Copy this file to .env and fill in your Supabase credentials.
# DO NOT commit .env to version control.

# Supabase project URL (e.g. https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose in browser — RLS protects data)
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (server-side ONLY — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth (legacy fallback — not used with Supabase Auth)
ADMIN_PASS=
SESSION_SECRET=

# Customize — private storage for customer car photos (server-side only).
# Requires VITE_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above; without them the
# photos are kept inline so the feature still works on the JSON driver.
CUSTOMIZE_BUCKET=customize-uploads
CUSTOMIZE_SIGNED_URL_TTL=300
CUSTOMIZE_MAX_IMAGE_BYTES=6291456
